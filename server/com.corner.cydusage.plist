<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.corner.cydusage</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/eunitembam3/cyd/server/usage_server.py</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- Deliberately NOT set: ProcessType=Background, LowPriorityIO, Nice.
         They look right for a helper daemon, but this job has a latency
         contract: the board gives up on a response after 5s
         (firmware/cyd_dashboard/net.cpp's http.setTimeout) and treats the
         miss as evidence it is offline. ProcessType=Background confines the
         process to efficiency cores on Apple Silicon and opts it into
         aggressive timer coalescing, which is exactly the wrong trade here.
         The installed copy in ~/Library/LaunchAgents has never had these
         keys; this file previously did, so re-copying it would have silently
         changed the running behaviour. CPU cost is negligible either way —
         the real power concern is sleep-prevention, handled by
         battery_guard_loop in usage_server.py, not by scheduler priority. -->
    <key>StandardOutPath</key>
    <string>/tmp/cydusage.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/cydusage.err</string>
</dict>
</plist>
