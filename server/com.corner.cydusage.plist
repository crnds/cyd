<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.corner.cydusage</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/eunitembam3/cyd/server/usage_server.py</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- Background + low-priority I/O: tell launchd this is a helper, not
         interactive UI work. Helps App Nap / scheduler deprioritize us when
         the Mac is trying to idle (the real power cost is sleep-prevention
         from board polls; CPU itself is already tiny). -->
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>5</integer>
    <key>StandardOutPath</key>
    <string>/tmp/cydusage.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/cydusage.err</string>
</dict>
</plist>
